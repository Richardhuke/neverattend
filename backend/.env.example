# ---- 服务 ----
PORT=8000
# 静态资源目录（前端构建产物）
STATIC_DIR=../backend/static

# ---- 浙大体艺（tyys）----
# 服务根地址。CAS 登录入口即 ${TYYS_BASE}/cas/appLogin
TYYS_BASE=http://www.tyys.zju.edu.cn/cgapp-server
# 1 = 使用内置 Mock（无账号也能跑通全链路演示）；0 = 打真实接口
TYYS_MOCK=1
# 真实接口路径表，留空则用 src/services/tyys.js 里的默认表
TYYS_ENDPOINTS_FILE=./config/tyys.endpoints.json

# ---- 自动签到轮询（模仿 ZJU-live-better）----
WATCH_INTERVAL_MS=10000
WATCH_AUTO_CHECKIN=1
# 可选：钉钉机器人 webhook，签到结果推群
DINGTALK_WEBHOOK=
